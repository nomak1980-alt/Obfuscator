{
  "name": "obfuscator",
  "version": "1.0.0",
  "description": "Eine einfache Web-Anwendung zur Verschleierung von C# und MS SQL Code für die sichere Weitergabe an KI-Modelle.",
  "main": "obfuscator-core.js",
  "scripts": {
    "test": "node test/core.test.js && node test/integration.test.js && node test/persistence.test.js && node test/smoke.test.js && node test/layout.test.js",
    "lint": "eslint obfuscator.js obfuscator-core.js test --max-warnings 0",
    "coverage": "c8 --reporter=text --reporter=html --include=obfuscator-core.js --include=obfuscator.js npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nomak1980-alt/Obfuscator.git"
  },
  "keywords": [
    "obfuscation",
    "csharp",
    "mssql"
  ],
  "author": "Robert Schellenberger",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nomak1980-alt/Obfuscator/issues"
  },
  "homepage": "https://github.com/nomak1980-alt/Obfuscator#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1"
  }
}
